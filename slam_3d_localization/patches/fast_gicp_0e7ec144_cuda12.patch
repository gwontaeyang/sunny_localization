diff --git a/CMakeLists.txt b/CMakeLists.txt
index dcc5bdc..65847e5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -112,3 +112,36 @@ endif()
 if(BUILD_VGICP_CUDA)
   set(CUDA_NVCC_FLAGS "--expt-relaxed-constexpr")
+
+  # fast_gicp still uses CMake's legacy FindCUDA module, which does not honor
+  # CMAKE_CUDA_ARCHITECTURES. Translate the modern setting explicitly so the
+  # generated binaries do not inherit a host-dependent default architecture.
+  if(CMAKE_CUDA_ARCHITECTURES)
+    foreach(cuda_architecture IN LISTS CMAKE_CUDA_ARCHITECTURES)
+      if(cuda_architecture MATCHES "^([0-9]+)-virtual$")
+        set(cuda_architecture_number "${CMAKE_MATCH_1}")
+        set(cuda_architecture_code "compute_${cuda_architecture_number}")
+      elseif(cuda_architecture MATCHES "^([0-9]+)-real$")
+        set(cuda_architecture_number "${CMAKE_MATCH_1}")
+        set(cuda_architecture_code "sm_${cuda_architecture_number}")
+      elseif(cuda_architecture MATCHES "^([0-9]+)$")
+        set(cuda_architecture_number "${CMAKE_MATCH_1}")
+        list(APPEND CUDA_NVCC_FLAGS
+          "-gencode=arch=compute_${cuda_architecture_number},code=sm_${cuda_architecture_number}"
+          "-gencode=arch=compute_${cuda_architecture_number},code=compute_${cuda_architecture_number}")
+        continue()
+      else()
+        message(FATAL_ERROR
+          "Unsupported CMAKE_CUDA_ARCHITECTURES entry for legacy FindCUDA: "
+          "${cuda_architecture}. Use a numeric value such as 87 or 90-virtual.")
+      endif()
+
+      list(APPEND CUDA_NVCC_FLAGS
+        "-gencode=arch=compute_${cuda_architecture_number},code=${cuda_architecture_code}")
+    endforeach()
+    message(STATUS "fast_gicp CUDA architectures: ${CMAKE_CUDA_ARCHITECTURES}")
+  else()
+    message(WARNING
+      "CMAKE_CUDA_ARCHITECTURES is unset; legacy FindCUDA will choose its "
+      "toolchain-dependent defaults")
+  endif()
   add_definitions(-DUSE_VGICP_CUDA)
