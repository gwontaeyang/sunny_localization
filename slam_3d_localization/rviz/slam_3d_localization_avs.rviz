Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Reference Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 100
      Cell Size: 1
      Alpha: 0.25
    - Class: rviz_default_plugins/TF
      Name: Localization TF
      Enabled: true
      Show Names: true
      Frame Timeout: 15
    - Class: rviz_default_plugins/PointCloud2
      Name: Prior Classified RGB Map (Reference)
      Enabled: true
      Topic:
        Value: /localization_3d/global_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Size (m): 0.04
      Style: Points
      Color Transformer: RGB8
      Alpha: 0.45
      Queue Size: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Live Merged LiDAR
      Enabled: true
      Topic:
        Value: /lidar/points_merged
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.035
      Style: Points
      Color Transformer: Intensity
      Alpha: 0.9
      Queue Size: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: Localization Aligned Scan
      Enabled: true
      Topic:
        Value: /localization_3d/aligned_points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.055
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 80; 20
      Alpha: 1
      Queue Size: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: Registration Local Map
      Enabled: true
      Topic:
        Value: /localization_3d/local_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Size (m): 0.035
      Style: Points
      Color Transformer: AxisColor
      Alpha: 0.7
      Queue Size: 1
    - Class: rviz_default_plugins/Odometry
      Name: Localization Pose
      Enabled: true
      Topic:
        Value: /localization_3d/odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.02
    - Class: rviz_default_plugins/Odometry
      Name: Input Odometry
      Enabled: false
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow
      Keep: 300
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Localization View
      Pitch: 0.75
      Target Frame: map
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
